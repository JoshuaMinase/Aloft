            "description": "Get detailed information about a specific POI by its source ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has poi data', () => pm.expect(pm.response.json()).to.have.property('source_id'));"
                ]
              }
            }
          ]
