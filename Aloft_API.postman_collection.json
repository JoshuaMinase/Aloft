            }
          ]
        }
      ]
    },
    {
      "name": "Audio",
      "item": [
        {
          "name": "Synthesize Audio for POI",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/pois/{{source_id}}/audio?language=en&voice_id=EXAVITQu4vr4xnSDxMaL",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "pois", "{{source_id}}", "audio"],
              "query": [
                { "key": "language", "value": "en" },
                { "key": "voice_id", "value": "EXAVITQu4vr4xnSDxMaL" }
              ]
            },
            "description": "Synthesize MP3 narration audio for a POI story using ElevenLabs. Returns raw MP3 bytes. Story must exist first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('audio content type', () => pm.expect(pm.response.headers['Content-Type']).to.include('audio'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mix Audio with Music",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/pois/{{source_id}}/audio/mix?music_track=peaceful",
              "host": ["{{baseUrl}}"],
