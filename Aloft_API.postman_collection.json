{
  "info": {
    "_postman_id": "aloft-api-collection-v1",
    "name": "Aloft API",
    "description": "Complete Postman collection for the Aloft backend API. Covers auth, flights, POIs, stories, audio, sessions, legal, GDPR, journal, favorites, upcoming flights, location, and health endpoints.\n\n**How to use:**\n1. Set the `baseUrl` variable to your server (default: http://localhost:8000)\n2. Run `POST /v1/auth/signup` then `POST /v1/auth/login`\n3. The login request auto-saves `access_token` and `refresh_token` to collection variables\n4. Use POST /v1/routes/pois to discover POIs and get route_bundle_key\n5. All protected requests use `{{access_token}}` in the Authorization header automatically\n\nNote: Email verification is disabled — accounts are auto-verified on signup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token",     "value": "",                      "type": "string" },
    { "key": "refresh_token",    "value": "",                      "type": "string" },
    { "key": "route_bundle_key", "value": "",                      "type": "string" },
    { "key": "source_id",        "value": "wikipedia:12345",       "type": "string" },
    { "key": "session_id",       "value": "",                      "type": "string" },
    { "key": "share_token",      "value": "",                      "type": "string" },
    { "key": "job_id",           "value": "",                      "type": "string" },
    { "key": "entry_id",         "value": "",                      "type": "string" },
    { "key": "favorite_id",      "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Returns {status: ok} when the process is alive. No auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check (readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] },
            "description": "Checks MongoDB and Redis connectivity. Returns 503 if MongoDB is down."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx or 503', () => {",
                  "  pm.expect([200,503]).to.include(pm.response.code);",
                  "});",
                  "pm.test('has mongodb field', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('mongodb');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"strongpassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["v1","auth","signup"] },
            "description": "Create a new account. Account is auto-verified — you can log in immediately after signup."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('message field present', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"strongpassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1","auth","login"] },
            "description": "Authenticate with email + password. Auto-saves tokens to collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "  console.log('Tokens saved to collection variables');",
                  "}",
                  "pm.test('access_token present', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.test('refresh_token present', () => pm.expect(body.refresh_token).to.be.a('string'));",
                  "pm.test('token_type is bearer', () => pm.expect(body.token_type).to.eql('bearer'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["v1","auth","refresh"] },
            "description": "Exchange refresh token for a new access + refresh token pair (rotation)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["v1","auth","me"] },
            "description": "Returns the authenticated user's public profile. Requires Bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has user_id', () => pm.expect(body).to.have.property('user_id'));",
                  "pm.test('has email', () => pm.expect(body).to.have.property('email'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["v1","auth","forgot-password"] },
            "description": "Sends a password reset email. Always returns 202 to prevent enumeration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_RESET_TOKEN_HERE\",\n  \"new_password\": \"newstrongpassword456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["v1","auth","reset-password"] },
            "description": "Reset password using the token from the forgot-password email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has message', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["v1","auth","logout"] },
            "description": "Invalidates the refresh token. Returns 204 No Content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Flights",
      "item": [
        {
          "name": "Discover Flight",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"ET601\",\n  \"date\": \"2024-01-15\",\n  \"corridorWidth\": 100.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/flights/discover",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flights", "discover"]
            },
            "description": "Discover POIs for a flight using flight number. Returns route_key and pois. Requires authentication."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has route_key', () => pm.expect(pm.response.json()).to.have.property('routeKey'));",
                  "pm.test('has pois', () => pm.expect(pm.response.json()).to.have.property('pois'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Discover POIs for Flight Number",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/flights/ET601/pois?width_km=20.0",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flights", "ET601", "pois"],
              "query": [
                { "key": "width_km", "value": "20.0" }
              ]
            },
            "description": "Discover POIs for a specific flight number using AeroDataBox/AviationStack. Returns departure, arrival, pois, and stats."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has departure', () => pm.expect(pm.response.json()).to.have.property('departure'));",
                  "pm.test('has arrival', () => pm.expect(pm.response.json()).to.have.property('arrival'));",
                  "pm.test('has pois', () => pm.expect(pm.response.json()).to.have.property('pois'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"route_bundle_key\": \"{{route_bundle_key}}\",\n  \"departure_date\": \"2024-01-15\",\n  \"preferences\": {\n    \"interests\": [\"history\", \"nature\"]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions"]
            },
            "description": "Create a new storytelling session for a flight route. Auto-saves session_id. Requires route_bundle_key from POIs discovery."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.session_id) {",
                  "  pm.collectionVariables.set('session_id', body.session_id);",
                  "}",
                  "pm.test('has session_id', () => pm.expect(pm.response.json()).to.have.property('session_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/{{session_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions", "{{session_id}}"]
            },
            "description": "Get session details including status and generated content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has session_id', () => pm.expect(pm.response.json()).to.have.property('session_id'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Session Position",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_position\": {\n    \"latitude\": 40.7128,\n    \"longitude\": -74.0060,\n    \"altitude_ft\": 35000,\n    \"timestamp\": \"2024-01-15T12:00:00Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/{{session_id}}/position",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions", "{{session_id}}", "position"]
            },
            "description": "Update the current position of the aircraft during the session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Share Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/{{session_id}}/share",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions", "{{session_id}}", "share"]
            },
            "description": "Generate a shareable token for the session. Auto-saves share_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.share_token) {",
                  "  pm.collectionVariables.set('share_token', body.share_token);",
                  "}",
                  "pm.test('has share_token', () => pm.expect(pm.response.json()).to.have.property('share_token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Shared Session",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/shared/{{share_token}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions", "shared", "{{share_token}}"]
            },
            "description": "Access a shared session without authentication using the share token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Session",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/{{session_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions", "{{session_id}}"]
            },
            "description": "Delete a session and all its associated data."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "POIs",
      "item": [
        {
          "name": "Discover POIs Along Route",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departure\": {\"lat\": 8.98, \"lng\": 38.79},\n  \"arrival\": {\"lat\": 25.25, \"lng\": 55.36},\n  \"width_km\": 100.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/routes/pois?auto_images=false",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "routes", "pois"],
              "query": [
                { "key": "auto_images", "value": "false" }
              ]
            },
            "description": "Discover POIs along a flight corridor using lat/lng coordinates. Returns pois, route_bundle_key, and stats."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
