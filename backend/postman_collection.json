{
  "info": {
    "_postman_id": "aloft-api-v1-stable",
    "name": "Aloft API v1 — Stable Dev Flow",
    "description": "Dev-only auth flow: signup → dev-verify → login. No emails. Tokens refresh automatically on 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "route_key", "value": "add-dxb-abc123", "type": "string" },
    { "key": "session_id", "value": "", "type": "string" },
    { "key": "source_id", "value": "", "type": "string" },
    { "key": "job_id", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const at = pm.collectionVariables.get('access_token') || '';",
          "const rt = pm.collectionVariables.get('refresh_token') || '';",
          "if (!at && rt && rt.length > 20) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('base_url') + '/v1/auth/refresh',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ refresh_token: rt }) }",
          "  }, function (err, res) {",
          "    if (!err && res.code === 200) {",
          "      const d = res.json();",
          "      pm.collectionVariables.set('access_token', d.access_token);",
          "      pm.collectionVariables.set('refresh_token', d.refresh_token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "Ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health/ready", "host": ["{{base_url}}"], "path": ["health", "ready"] }
          }
        }
      ]
    },
    {
      "name": "Legal",
      "item": [
        { "name": "List Legal Documents", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/v1/legal/", "host": ["{{base_url}}"], "path": ["v1", "legal", ""] } } },
        { "name": "Get Privacy Policy", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/v1/legal/privacy_policy", "host": ["{{base_url}}"], "path": ["v1", "legal", "privacy_policy"] } } },
        { "name": "Get Terms of Service", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/v1/legal/terms_of_service", "host": ["{{base_url}}"], "path": ["v1", "legal", "terms_of_service"] } } },
        { "name": "Get Cookie Policy", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/v1/legal/cookie_policy", "host": ["{{base_url}}"], "path": ["v1", "legal", "cookie_policy"] } } }
      ]
    },
    {
      "name": "01 Auth — Dev Flow",
      "item": [
        {
          "name": "Signup",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 201', () => pm.response.to.have.status(201));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"testuser@aloft.app\", \"password\": \"strongpass123\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/auth/signup", "host": ["{{base_url}}"], "path": ["v1", "auth", "signup"] } }
        },
        {
          "name": "Dev Verify (no email needed)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('verified', () => pm.expect(pm.response.json().message).to.include('verified'));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"testuser@aloft.app\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/auth/dev-verify", "host": ["{{base_url}}"], "path": ["v1", "auth", "dev-verify"] } }
        },
        {
          "name": "Login → auto-saves tokens",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "const data = pm.response.json();", "if(data.access_token){ pm.collectionVariables.set('access_token', data.access_token); }", "if(data.refresh_token){ pm.collectionVariables.set('refresh_token', data.refresh_token); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"testuser@aloft.app\", \"password\": \"strongpass123\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/auth/login", "host": ["{{base_url}}"], "path": ["v1", "auth", "login"] } }
        },
        { "name": "Refresh Tokens", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"refresh_token\": \"{{refresh_token}}\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["v1", "auth", "refresh"] } } }
      ]
    },
    {
      "name": "02 Auth — Protected",
      "item": [
        {
          "name": "Get Me (verify auth works)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('email is verified', () => pm.expect(pm.response.json().is_verified).to.eql(true));"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/auth/me", "host": ["{{base_url}}"], "path": ["v1", "auth", "me"] } }
        },
        {
          "name": "Logout",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"refresh_token\": \"{{refresh_token}}\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/auth/logout", "host": ["{{base_url}}"], "path": ["v1", "auth", "logout"] } }
        }
      ]
    },
    {
      "name": "03 Routes — Discovery",
      "item": [
        {
          "name": "Discover POIs by Coordinates",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.collectionVariables.set('route_key', json.route_key);", "if (json.poi_source_ids && json.poi_source_ids.length > 0) { pm.collectionVariables.set('source_id', json.poi_source_ids[0]); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"departure\": {\"lat\": 9.03, \"lng\": 38.74}, \"arrival\": {\"lat\": 25.28, \"lng\": 55.36}, \"width_km\": 20}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/routes/pois?auto_images=true&language=en", "host": ["{{base_url}}"], "path": ["v1", "routes", "pois"], "query": [{ "key": "auto_images", "value": "true" }, { "key": "language", "value": "en" }] } }
        },
        {
          "name": "Discover POIs by IATA Codes (no auto images)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"departure_iata\": \"ADD\", \"arrival_iata\": \"DXB\", \"width_km\": 20}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/routes/pois?language=en", "host": ["{{base_url}}"], "path": ["v1", "routes", "pois"], "query": [{ "key": "language", "value": "en" }] } }
        }
      ]
    },
    {
      "name": "04 Content Generation (Batch)",
      "item": [
        {
          "name": "Queue Content Generation for Route",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('has job_id', () => pm.expect(pm.response.json().job_id).to.be.a('string'));", "pm.test('has total_pois', () => pm.expect(pm.response.json().total_pois).to.be.a('number'));", "if(pm.response.json().job_id){ pm.collectionVariables.set('job_id', pm.response.json().job_id); }"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/routes/{{route_key}}/content", "host": ["{{base_url}}"], "path": ["v1", "routes", "{{route_key}}", "content"] } }
        },
        {
          "name": "Get Content Generation Status",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('has status field', () => ['pending', 'processing', 'completed', 'failed'].includes(pm.response.json().status));", "pm.test('has progress_percent', () => pm.expect(pm.response.json().progress_percent).to.be.a('number'));", "console.log('Progress:', pm.response.json().progress_percent + '%');"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/routes/{{route_key}}/content/status?job_id={{job_id}}", "host": ["{{base_url}}"], "path": ["v1", "routes", "{{route_key}}", "content", "status"], "query": [{ "key": "job_id", "value": "{{job_id}}" }] } }
        }
      ]
    },
    {
      "name": "05 Stories",
      "item": [
        {
          "name": "Generate Story",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('has text', () => pm.expect(pm.response.json().text_content.length).to.be.above(0));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/pois/{{source_id}}/story?language=en", "host": ["{{base_url}}"], "path": ["v1", "pois", "{{source_id}}", "story"], "query": [{ "key": "language", "value": "en" }] } }
        }
      ]
    },
    {
      "name": "06 Audio",
      "item": [
        {
          "name": "Synthesize Narration Audio",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/pois/{{source_id}}/audio?language=en", "host": ["{{base_url}}"], "path": ["v1", "pois", "{{source_id}}", "audio"], "query": [{ "key": "language", "value": "en" }] } }
        },
        {
          "name": "Synthesize Mixed Audio (with music)",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/pois/{{source_id}}/audio/mixed?language=en&track_id=mixkit-feedback-dreams", "host": ["{{base_url}}"], "path": ["v1", "pois", "{{source_id}}", "audio", "mixed"], "query": [{ "key": "language", "value": "en" }, { "key": "track_id", "value": "mixkit-feedback-dreams" }] } }
        }
      ]
    },
    {
      "name": "07 Images",
      "item": [
        {
          "name": "Fetch Images for POI",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.test('has images array', () => Array.isArray(pm.response.json().images));"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/pois/{{source_id}}/images?max_images=4", "host": ["{{base_url}}"], "path": ["v1", "pois", "{{source_id}}", "images"], "query": [{ "key": "max_images", "value": "4" }] } }
        }
      ]
    },
    {
      "name": "08 Sessions",
      "item": [
        {
          "name": "Start Session",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('session_id', pm.response.json().session_id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"route_key\": \"{{route_key}}\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/sessions", "host": ["{{base_url}}"], "path": ["v1", "sessions"] } }
        },
        {
          "name": "Update Position",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"lat\": 15.5, \"lng\": 42.3, \"language\": \"en\", \"trigger_radius_km\": 50}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/sessions/{{session_id}}/position", "host": ["{{base_url}}"], "path": ["v1", "sessions", "{{session_id}}", "position"] } }
        }
      ]
    },
    {
      "name": "09 GDPR — User Data",
      "item": [
        { "name": "Export All User Data", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/user/data", "host": ["{{base_url}}"], "path": ["v1", "user", "data"] } } },
        { "name": "Request Async Export", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"format\": \"json\", \"include_audio\": true, \"include_images\": true}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/user/data/request-export", "host": ["{{base_url}}"], "path": ["v1", "user", "data", "request-export"] } } },
        { "name": "Get Data Status", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/v1/user/data/status", "host": ["{{base_url}}"], "path": ["v1", "user", "data", "status"] } } },
        { "name": "Delete All User Data", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "DELETE", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\"require_confirmation\": true, \"reason\": \"Testing\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{base_url}}/v1/user/data", "host": ["{{base_url}}"], "path": ["v1", "user", "data"] } } }
      ]
    }
  ]
}