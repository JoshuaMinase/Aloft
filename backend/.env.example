# Copy this file to .env and fill in real values. This file itself has
# no secrets in it — it's just documentation of what the app expects.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=aloft

# --- Cache ---
REDIS_URL=redis://default:<password>@<upstash-endpoint>:<port>

# --- Flight data ---
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AVIATIONSTACK_API_KEY=

# --- AI / story generation ---
GROQ_API_KEY=

# --- Voice (TTS) ---
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORRIDOR_WIDTH_KM=100
APP_CONTACT_EMAIL=you@example.com
