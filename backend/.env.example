# Copy this file to .env and fill in real values.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=aloft

# --- Cache ---
REDIS_URL=redis://default:<password>@<upstash-endpoint>:<port>

# --- Flight data ---
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AVIATIONSTACK_API_KEY=

# --- AI / story generation ---
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# --- Voice (TTS) ---
# GOOGLE_APPLICATION_CREDENTIALS is not read directly by this app --
# Google's client library reads it via Application Default Credentials.
# Point it at a real service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
TTS_LANGUAGE_CODE=en-US
TTS_VOICE_NAME=en-US-Wavenet-D
AUDIO_STORAGE_DIR=./audio_storage

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORRIDOR_WIDTH_KM=100
APP_CONTACT_EMAIL=you@example.com
